{
  "name": "claimrot",
  "version": "0.1.0",
  "description": "Extract and monitor structured facts from public web pages with local history and self-healing.",
  "license": "MIT",
  "repository": "https://github.com/claimrot/claimrot",
  "type": "module",
  "bin": { "claimrot": "./dist/src/cli.js" },
  "scripts": {
    "build": "tsc && cp src/db/schema.sql dist/src/db/",
    "build:pages": "tsx scripts/build-pages.ts",
    "check:pages-demo": "tsx scripts/build-pages.ts --check-demo docs/demo/index.html",
    "sync:pages-demo": "tsx scripts/build-pages.ts --demo-only docs/demo/index.html",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "better-sqlite3": "^11.0.0",
    "commander": "^12.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
